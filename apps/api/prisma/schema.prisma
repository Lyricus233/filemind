// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IndexStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model File {
  id               String            @id @default(uuid()) @db.Uuid
  originalName     String
  mimeType         String
  sizeBytes        BigInt
  storageKey       String?           @unique
  contentHash      String?           @db.Char(64)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  chunks           FileChunk[]
  indexStatus      IndexStatus       @default(PENDING)
  indexJobId       String?           @db.Uuid
  vectorCollection String?
  indexedAt        DateTime?
  deletedAt        DateTime?
  vectorIndexes    FileVectorIndex[]

  @@index([vectorCollection, indexStatus])
  @@index([deletedAt])
  @@index([contentHash, deletedAt])
  @@map("files")
}

model FileVectorIndex {
  fileId     String   @db.Uuid
  collection String
  createdAt  DateTime @default(now())
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([fileId, collection])
  @@map("file_vector_indexes")
}

model FileChunk {
  id          String   @id @default(uuid()) @db.Uuid
  fileId      String   @db.Uuid
  index       Int
  content     String
  startOffset Int
  endOffset   Int
  createdAt   DateTime @default(now())
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, index])
  @@map("file_chunks")
}
